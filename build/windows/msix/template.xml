<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ldbeditor"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\LevelDB Editor">
    </Installer>
    <PackageInformation
        PackageName="LevelDB Editor"
        PackageDisplayName="LevelDB Editor"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.0.1.0"
        PackageDescription="A ldbeditor application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.ldbeditor"
                Description="A ldbeditor application"
                DisplayName="LevelDB Editor"
                ExecutableName="ldbeditor"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>LevelDB Editor</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>A ldbeditor application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ldbeditor.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
